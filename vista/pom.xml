<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>mx.avanti.desarrollo.autenticacion</groupId>
        <artifactId>desarrollo</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>vista</artifactId>
    <packaging>jar</packaging>
    <name>PapelPoint - Escritorio</name>

    <dependencies>
        <dependency>
            <groupId>mx.avanti.desarrollo.autenticacion</groupId>
            <artifactId>entidad</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>mx.avanti.desarrollo.autenticacion</groupId>
            <artifactId>negocio</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>mx.avanti.desarrollo.autenticacion</groupId>
            <artifactId>persistencia</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.netbeans.external</groupId>
            <artifactId>AbsoluteLayout</artifactId>
            <version>RELEASE270</version>
        </dependency>
    </dependencies>

<build>
    <resources>
        <resource>
            <directory>src/main/java</directory>
            <excludes>
                <exclude>**/*.java</exclude>
            </excludes>
        </resource>
        <resource>
            <directory>src/main/resources</directory>
        </resource>
    </resources>
    <plugins>
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>3.13.0</version>
        </plugin>
    </plugins>
</build>
  
</project>
  